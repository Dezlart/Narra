{
  "name": "narra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --exclude tests/*.integration.test.ts",
    "test:auth:integration": "vitest run tests/auth.integration.test.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "env:check:production": "tsx scripts/check-production-env.ts",
    "test:migrations:fresh": "tsx scripts/check-fresh-migrations.ts",
    "postinstall": "prisma generate",
    "test:articles:integration": "vitest run tests/articles.integration.test.ts",
    "test:moderation:integration": "vitest run tests/moderation.integration.test.ts",
    "test:public:integration": "vitest run tests/public-content.integration.test.ts",
    "db:seed": "prisma db seed",
    "test:social:integration": "vitest run tests/social.integration.test.ts",
    "test:notifications:integration": "vitest run tests/notifications.integration.test.ts",
    "test:admin:integration": "vitest run tests/administration.integration.test.ts tests/admin-protection.integration.test.ts",
    "test:quality:integration": "vitest run tests/quality.integration.test.ts",
    "test:account-menu:browser": "vitest run tests/account-menu.integration.test.ts",
    "test:mobile-auth:browser": "vitest run tests/mobile-auth.integration.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.6",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
