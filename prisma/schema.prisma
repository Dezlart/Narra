generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

// Moderation state belongs to each revision, not the publication itself.
enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleRevisionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // Nullable for legacy rows; mandatory and normalized for all new registrations.
  username      String?  @unique
  bio           String?
  role          UserRole @default(USER)
  isBanned      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  articles          Article[]         @relation("ArticleAuthor")
  reviewedRevisions ArticleRevision[] @relation("RevisionReviewer")
  sessions          Session[]
  accounts          Account[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Article {
  id                  String        @id @default(cuid())
  authorId            String
  slug                String?       @unique
  status              ArticleStatus @default(DRAFT)
  publishedRevisionId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  publishedAt         DateTime?

  author    User              @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  revisions ArticleRevision[] @relation("ArticleRevisions")
  images    ArticleImage[]

  // Composite FK prevents pointing at another article's revision.
  publishedRevision ArticleRevision? @relation("PublishedRevision", fields: [id, publishedRevisionId], references: [articleId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([authorId, updatedAt])
  @@index([status, publishedAt(sort: Desc)])
}

model ArticleRevision {
  id              String                @id @default(cuid())
  articleId       String
  title           String                @default("")
  excerpt         String                @default("")
  content         Json
  coverImage      String?
  categoryId      String?
  version         Int
  editVersion     Int                   @default(0)
  status          ArticleRevisionStatus @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  article    Article              @relation("ArticleRevisions", fields: [articleId], references: [id], onDelete: Cascade)
  category   Category?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewedBy User?                @relation("RevisionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  tags       ArticleRevisionTag[]

  // At most one publication can match this pair: Article.id is its primary key.
  publishedBy Article[] @relation("PublishedRevision")

  @@unique([articleId, version])
  @@unique([articleId, id])
  @@index([status, submittedAt])
  @@index([categoryId])
  @@index([reviewedById])
}

// Private Blob objects belong to the Article, so all its revisions can reuse them.
// Keep records/objects when deleting a draft revision; never remove shared images.
model ArticleImage {
  id        String   @id @default(cuid())
  articleId String
  pathname  String   @unique
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model Category {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  revisions   ArticleRevision[]
}

model Tag {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  revisions ArticleRevisionTag[]
}

// Category and tags are versioned so edits cannot bypass future moderation.
model ArticleRevisionTag {
  revisionId String
  tagId      String
  revision   ArticleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  tag        Tag             @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([revisionId, tagId])
  @@index([tagId])
}
