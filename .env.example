# Runtime: pooled Neon URL with TLS. Separate development/preview/production DBs.
# Never commit .env or expose secrets through NEXT_PUBLIC_*.
DATABASE_URL=
# Prisma 7 CLI: direct URL to the SAME database/branch. Optional locally.
# Supply explicitly in the production migration shell; not required at runtime/build.
DIRECT_URL=

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Exact origin: local http://localhost:3000; deployed HTTPS domain without a path.
BETTER_AUTH_URL=

# Private Vercel Blob store (local development). Never expose in NEXT_PUBLIC_*.
BLOB_READ_WRITE_TOKEN=
# On Vercel: connect a private store; SDK reads managed OIDC from request context.
BLOB_STORE_ID=

# Production canonical HTTPS origin; must match BETTER_AUTH_URL.
# Leave empty locally and in Preview. No trailing path.
SITE_URL=

# Server-only HMAC key for daily, article-scoped view deduplication (32+ chars).
# Generate independently from BETTER_AUTH_SECRET.
ANALYTICS_HASH_SECRET=

# NODE_ENV, VERCEL and VERCEL_ENV are platform-managed. At runtime Vercel passes
# OIDC in request context; never add or copy VERCEL_OIDC_TOKEN manually.
# Preview needs separate DB/store/keys.
# No email provider keys are used.
