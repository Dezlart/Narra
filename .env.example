# Standard PostgreSQL connection URL. Use a dedicated development database locally.
# Obtain credentials from your PostgreSQL instance; never commit this value.
DATABASE_URL=

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Private Vercel Blob store (local development). Never expose in NEXT_PUBLIC_*.
BLOB_READ_WRITE_TOKEN=
# Optional on Vercel: connect a private store; SDK uses managed OIDC credentials.
BLOB_STORE_ID=
